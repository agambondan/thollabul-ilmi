[Unit]
Description=Weekly scraper for Thullaabul Ilmi YouTube kajian
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/works/me/thollabul-ilmi
Environment=COOKIES=
Environment=MAX_VIDEOS=20
ExecStart=/home/deploy/works/me/thollabul-ilmi/services/api/scripts/scrape_kajian_cron.sh
StandardOutput=append:/var/log/thollabul-kajian-scrape.log
StandardError=append:/var/log/thollabul-kajian-scrape.log
Nice=10

[Install]
WantedBy=multi-user.target
