PORT=9900
ENDPOINT=/api/v1/
ENVIRONMENT=local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=thullabul_ilmi
DB_TABLE_PREFIX=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_INDEX=3
BODY_LIMIT_BYTES=26214400
LIBRARY_UPLOAD_MAX_BYTES=26214400
MINIO_ENDPOINT=localhost:9020
MINIO_PUBLIC_URL=http://localhost:9020
MINIO_ACCESS=minioadmin
MINIO_SECRET=minioadmin
MINIO_LIBRARY_BUCKET=thollabul-ilmi-library
MINIO_USE_SSL=false
PREFORK=false
CACHE_TTL_SECONDS=60
EXPO_PUSH_ENABLED=true
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_CHANNEL_ID=daily-reminders
EXPO_PUSH_TIMEOUT_SECONDS=10
ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8081,http://localhost:19006,http://localhost:23000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://127.0.0.1:8081,http://127.0.0.1:19006,http://127.0.0.1:23000
ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
SENTRY_DSN=

# Database
DB_DRIVER=postgres

# Auth
AES=<generate-a-random-aes-key>
SALT=<generate-a-random-salt>

# Monitoring
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_GLOBAL=180
RATE_LIMIT_SEARCH=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_DEV=120
